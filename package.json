{
  "name": "twx-payroll-desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src vite.config.ts",
    "test": "vitest run && npm run test:foundation && npm run test:manual && npm run test:installer",
    "test:foundation": "node scripts/verify-foundation.mjs",
    "test:ui": "node scripts/verify-ui.mjs",
    "format:check": "prettier --check src scripts/*.mjs vite.config.ts eslint.config.mjs package.json tsconfig.json index.html src-tauri/*.json src-tauri/capabilities/*.json",
    "verify:frontend": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:ui && npm run format:check",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "test:manual": "node scripts/manual-guide.mjs --check",
    "build:installer": "tauri build --bundles nsis -- --locked && node scripts/verify-installer.mjs --generated",
    "handoff": "node scripts/prepare-handoff.mjs",
    "test:installer": "node scripts/verify-installer.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.1.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
